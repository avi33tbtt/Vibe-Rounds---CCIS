{
  "manifest": {
    "id": "synthetic.demo-analytics",
    "name": "Synthetic demo analytics",
    "type": "analytics-package",
    "version": "0.1.0",
    "publisher": {
      "name": "Synthetic test publisher"
    },
    "standard": {
      "version": "0.1.0"
    },
    "status": "draft"
  },
  "question": "Synthetic question about the record",
  "intendedUsers": [
    "Synthetic reviewer"
  ],
  "population": "Synthetic population",
  "limitations": {
    "statement": "Synthetic limitations statement",
    "items": []
  },
  "operatorSet": {
    "name": "ccis-core-ops",
    "version": "0.1.0"
  },
  "interpretation": {
    "meaning": "Describes the record only",
    "prohibited": [
      "Do not use as a recommendation"
    ]
  },
  "executionProfile": {
    "maxSteps": 1000,
    "maxDepth": 16,
    "maxOutputBytes": 65536
  },
  "evidence": {
    "statement": "No external evidence is claimed",
    "sources": []
  },
  "provenance": {
    "origin": "Synthetic",
    "basis": "Synthetic"
  },
  "context": [
    {
      "ref": {
        "id": "synthetic.demo-element",
        "type": "contextual-element",
        "range": "^0.1.0"
      },
      "fields": [
        "startTime",
        "endTime"
      ]
    }
  ],
  "inputs": [
    {
      "key": "startTime",
      "element": "synthetic.demo-element",
      "field": "startTime",
      "type": "datetime"
    },
    {
      "key": "endTime",
      "element": "synthetic.demo-element",
      "field": "endTime",
      "type": "datetime",
      "onMissing": "needs-data"
    },
    {
      "key": "givenStatus",
      "element": "synthetic.demo-element",
      "field": "givenStatus",
      "type": "code",
      "onMissing": "indeterminate"
    }
  ],
  "parameters": [
    {
      "id": "targetInterval",
      "label": "Synthetic target interval",
      "kind": "duration",
      "units": [
        "min"
      ],
      "allowedRange": {
        "min": 0,
        "max": 100000
      },
      "enabledByDefault": false,
      "suppliedBy": "Local clinician (role)"
    },
    {
      "id": "acceptedCertainty",
      "label": "Synthetic accepted certainty",
      "kind": "choice",
      "allowedChoices": [
        "accept",
        "flag-only",
        "needs-data"
      ],
      "enabledByDefault": false,
      "suppliedBy": "Local clinician (role)"
    },
    {
      "id": "edgeRule",
      "label": "Synthetic edge rule",
      "kind": "choice",
      "allowedChoices": [
        "inside",
        "outside"
      ],
      "enabledByDefault": false,
      "suppliedBy": "Local clinician (role)"
    }
  ],
  "conversions": [
    {
      "id": "hoursToMinutes",
      "version": "1.0.0",
      "from": "h",
      "to": "min",
      "kind": "linear",
      "factor": 60
    },
    {
      "id": "zoneToUtc",
      "version": "1.0.0",
      "from": "local",
      "to": "utc",
      "kind": "time-zone"
    }
  ],
  "computation": [
    {
      "output": "interval",
      "expr": {
        "op": "if",
        "args": [
          {
            "op": "is-present",
            "args": [
              {
                "ref": "input",
                "id": "startTime"
              }
            ]
          },
          {
            "op": "time-diff",
            "args": [
              {
                "ref": "input",
                "id": "startTime"
              },
              {
                "ref": "input",
                "id": "endTime"
              }
            ]
          },
          {
            "literal": "needs-data"
          }
        ]
      }
    },
    {
      "output": "comparison",
      "expr": {
        "op": "if",
        "args": [
          {
            "op": "is-present",
            "args": [
              {
                "ref": "parameter",
                "id": "targetInterval"
              }
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "op": "le",
                "args": [
                  {
                    "op": "time-diff",
                    "args": [
                      {
                        "ref": "input",
                        "id": "startTime"
                      },
                      {
                        "ref": "input",
                        "id": "endTime"
                      }
                    ]
                  },
                  {
                    "ref": "parameter",
                    "id": "targetInterval"
                  }
                ]
              },
              {
                "literal": "within-target"
              },
              {
                "literal": "outside-target"
              }
            ]
          },
          {
            "literal": "parameter-not-enabled"
          }
        ]
      }
    }
  ],
  "outputs": [
    {
      "id": "interval",
      "kind": "value",
      "valueType": "time",
      "unit": "min",
      "states": [
        "needs-data",
        "indeterminate",
        "not-applicable",
        "conflict",
        "parameter-not-enabled"
      ],
      "carries": [
        "warnings",
        "limitations",
        "missingDataNotes",
        "certainty"
      ]
    },
    {
      "id": "comparison",
      "kind": "classification",
      "labels": [
        "within-target",
        "outside-target"
      ],
      "states": [
        "parameter-not-enabled",
        "indeterminate"
      ],
      "carries": [
        "warnings",
        "limitations",
        "missingDataNotes"
      ]
    }
  ]
}
