{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccis.invalid/schemas/rule-pack.schema.json",
  "title": "CCIS rule pack",
  "description": "A rule pack: manifest, class, scope, inputs, parameters, rules, tests and provenance (B10, B11). Shape only. Holds no number, default, threshold or band. Prototype. Synthetic data only. Not for clinical use.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": [
    "manifest",
    "class",
    "scope",
    "inputs",
    "parameters",
    "rules",
    "tests",
    "provenance",
    "sourceNote"
  ],
  "properties": {
    "manifest": {
      "allOf": [
        {
          "$ref": "https://ccis.invalid/schemas/manifest.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "rule-pack"
            }
          }
        }
      ]
    },
    "class": {
      "enum": [
        "data-quality",
        "clinical-prompt"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "pathways"
      ],
      "properties": {
        "pathways": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/reference"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "pathway"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "inputs": {
      "description": "Read by concept, never by label. The element id only narrows.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "required": [
          "id",
          "concept",
          "read"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/key"
          },
          "concept": {
            "$ref": "#/$defs/conceptKey"
          },
          "element": {
            "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/artefactId"
          },
          "read": {
            "enum": [
              "latest",
              "all",
              "count"
            ]
          }
        }
      }
    },
    "parameters": {
      "description": "Declared, never valued. No value, default or range (ED-40).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "required": [
          "id",
          "label",
          "kind",
          "enabledByDefault",
          "suppliedBy"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "enum": [
              "interval",
              "count"
            ]
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\S+$"
            }
          },
          "enabledByDefault": {
            "const": false
          },
          "suppliedBy": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sourceNote": {
      "$ref": "#/$defs/text"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "origin",
        "basis"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/text"
        },
        "basis": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "rules": {
      "description": "At most 20 rules. A rule has no write or action member; it only describes when a prompt is shown (B11).",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "required": [
          "id",
          "kind",
          "severity",
          "when",
          "message"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/key"
          },
          "kind": {
            "enum": [
              "missing",
              "stale",
              "conflicting",
              "inconsistent",
              "interval-documentation"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "attention"
            ]
          },
          "when": {
            "$ref": "#/$defs/expr"
          },
          "message": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template"
            ],
            "properties": {
              "template": {
                "type": "string",
                "pattern": "^\\S.{0,199}$",
                "description": "Plain text, at most 200 characters. Length is a pattern because maxLength makes the generated validator call require(), which fails in an ES module."
              }
            }
          }
        }
      }
    },
    "tests": {
      "description": "Each test names a rule, a synthetic fixture and the expected outcome. Parameters stay valueless (test-only enabling).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "required": [
          "id",
          "rule",
          "fixture",
          "synthetic",
          "enables",
          "expect"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/key"
          },
          "rule": {
            "$ref": "#/$defs/key"
          },
          "fixture": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "synthetic": {
            "const": true
          },
          "enables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parameter",
                "testOnly"
              ],
              "properties": {
                "parameter": {
                  "$ref": "#/$defs/key"
                },
                "testOnly": {
                  "const": true
                }
              }
            }
          },
          "expect": {
            "enum": [
              "fires",
              "does-not-fire",
              "not-evaluated"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "^\\S.*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "conceptKey": {
      "type": "string",
      "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
    },
    "expr": {
      "oneOf": [
        {
          "description": "Operator node. The operator must be on the whitelist (D-006).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "and",
                "or",
                "not",
                "is-present",
                "state-of",
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge",
                "add",
                "sub",
                "time-diff",
                "convert",
                "if",
                "count",
                "select",
                "min",
                "max",
                "coalesce"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        {
          "description": "Reference leaf: an input or a parameter (no conversion in a rule).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "id"
          ],
          "properties": {
            "ref": {
              "enum": [
                "input",
                "parameter"
              ]
            },
            "id": {
              "$ref": "#/$defs/key"
            }
          }
        },
        {
          "description": "Literal: a boolean or a string (an epistemic state or a label). Never a number.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
