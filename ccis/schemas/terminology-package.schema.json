{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccis.invalid/schemas/terminology-package.schema.json",
  "title": "CCIS local terminology package",
  "description": "Local concept keys and value sets: the vocabulary behind element concepts (ED-7, ED-9). Code system `local` only; external codes arrive as separate maps (ED-22). Holds no numbers, bands or thresholds.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["manifest", "codeSystem", "concepts", "provenance"],
  "properties": {
    "manifest": {
      "allOf": [
        { "$ref": "https://ccis.invalid/schemas/manifest.schema.json" },
        { "type": "object", "properties": { "type": { "const": "terminology-package" } } }
      ]
    },
    "codeSystem": {
      "description": "The one system this package defines. Only `local` exists in 0.2.0.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "local" },
        "version": { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/semver" }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["key", "display"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "display": { "$ref": "#/$defs/display" },
          "definition": { "type": "string", "pattern": "^\\S[\\s\\S]{0,499}$" },
          "category": { "enum": ["finding", "condition", "test", "procedure", "observation", "drug", "other"] },
          "deprecated": { "type": "boolean" },
          "replacedBy": { "$ref": "#/$defs/key" }
        },
        "dependentRequired": { "replacedBy": ["deprecated"] }
      }
    },
    "valueSets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["id", "version", "display", "members"],
        "properties": {
          "id": { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/artefactId" },
          "version": { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/semver" },
          "display": { "$ref": "#/$defs/display" },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": { "^x-": {} },
              "required": ["key"],
              "properties": {
                "key": { "$ref": "#/$defs/key" },
                "display": { "$ref": "#/$defs/display" }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["origin", "basis"],
      "properties": {
        "origin": { "type": "string", "pattern": "^\\S" },
        "basis": { "type": "string", "pattern": "^\\S" }
      }
    }
  },
  "$defs": {
    "key": {
      "description": "A local concept key: the identity. The same rule as the EMR local terms.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "display": {
      "description": "Plain text for people, never used for matching.",
      "type": "string",
      "pattern": "^\\S.{0,199}$"
    }
  }
}
